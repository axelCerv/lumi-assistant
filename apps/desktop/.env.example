# Credenciales OAuth para conectar Google Calendar y Outlook con un clic.
# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# Cómo obtenerlos: README → "Calendario con un clic (OAuth)".
# También se pueden poner dentro de la app: Ajustes → Calendario → Credenciales OAuth propias.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
MAIN_VITE_MICROSOFT_CLIENT_ID=
